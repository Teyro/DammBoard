<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Nur für Android 9 und älter nötig: ab Android 10 übernimmt Scoped Storage das Speichern. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" tools:node="replace" />
    <!-- Alte Tafeln (.ubmx2) auf dem ganzen Board suchen (Ablage → Einstellungen): ab Android 11 „Zugriff auf alle Dateien“, davor Speicher lesen -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" tools:node="replace" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:node="replace" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- Stundenplan aus DammTable (Fach der laufenden Stunde, Symbole der Fächer) – nur mit demselben Schlüssel -->
    <uses-permission android:name="de.oejendorferdamm.dammtable.permission.STUNDENPLAN" />
    <queries>
        <provider android:authorities="de.oejendorferdamm.dammtable.stundenplan" />
    </queries>
    <!-- Für die In-App-Aktualisierung: Installation der von GitHub heruntergeladenen Update-APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Nur für die Lautstärke-Ampel (Werkzeugkasten → Extras); es wird nichts aufgenommen oder gespeichert. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Dokumentenkamera (USB/UVC, vom Board als externe Kamera weitergereicht) – kein Muss für die Installation -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.external" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.DammBoard"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|touchscreen|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Theme.DammBoard">
            <!-- configChanges: Die Oberfläche ist komplett Compose und passt sich selbst an. Ohne
                 diese Angabe würde Android die Activity z. B. beim Anstecken einer Tastatur, beim
                 Umschalten des Bildschirmmodus oder bei Änderung der Anzeigegröße neu starten –
                 und dabei den gesamten Tafelinhalt aller Seiten verwerfen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
